#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

&lt {
    tapping-term-ms = <250>;
    quick-tap-ms = <250>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
    
    macros {
        mc_home: minecraft_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp T &kp FSLH &kp H &kp O &kp M &kp E &kp ENTER>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "Base Layer";
            bindings = <
        //╭─────────────┬─────────────┬────────────┬────────────┬───────────╮   ╭───────────┬───────────────┬────────────┬─────────────┬────────────────╮
        //│ Q           │ W           │ E          │ R          │ T         │   │ Y         │ U             │ I          │ O           │ P              │
            &kp Q         &kp W         &kp E        &kp R        &kp T           &kp Y       &kp U           &kp I        &kp O         &kp P
        //├─────────────┼─────────────┼────────────┼────────────┼───────────┤   ├───────────┼───────────────┼────────────┼─────────────┼────────────────┤
        //│ A (Shift)   │ S (Ctrl)    │ D (Alt)    │ F (Super)  │ G         │   │ H         │ J (Super)     │ K (Alt)    │ L (Ctrl)    │ ; : (Shift)    │
            &ht LSHFT A   &ht LCTRL S   &ht LALT D   &ht LGUI F   &kp G           &kp H       &ht RGUI J      &ht RALT K   &ht RCTRL L   &ht RSHFT SEMI
        //├─────────────┼─────────────┼────────────┼────────────┼───────────┤   ├───────────┼───────────────┼────────────┼─────────────┼────────────────┤
        //│ Z           │ X           │ C          │ V          │ B         │   │ N         │ M             │ , <        │ . >         │ ' "            │
            &kp Z         &kp X         &kp C        &kp V        &kp B           &kp N       &kp M           &kp COMMA    &kp DOT       &kp SQT
        //╰─────────────┴─────────────┴────────────┼────────────┼───────────┤   ├───────────┼───────────────┼────────────┴─────────────┴────────────────╯
        //                                         │ Tab (2)    │ Space     │   │ Enter     │ Backspace (1) │
                                                     &lt 2 TAB    &kp SPACE       &kp ENTER   &lt 1 BSPC
        //                                         ╰────────────┴───────────╯   ╰───────────┴───────────────╯
            >;
        };

        right_layer {
            display-name = "Right Layer";
            bindings = <
        //╭────────────┬──────────┬──────────┬──────────┬──────────╮   ╭────────────┬──────────────┬──────────────┬───────────┬────────╮
        //│            │ 1        │ 2        │ 3        │          │   │ Home       │ Pg Dn        │ Pg Up        │ End       │        │
            &trans       &kp N1     &kp N2     &kp N3     &trans         &kp HOME     &kp PG_DN      &kp PG_UP      &kp END     &trans
        //├────────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────┼──────────────┼──────────────┼───────────┼────────┤
        //│ Delete     │ 4        │ 5        │ 6        │          │   │ Left       │ Down         │ Up           │ Right     │        │
            &kp DEL      &kp N4     &kp N5     &kp N6     &trans         &kp LEFT     &kp DOWN       &kp UP         &kp RIGHT   &trans
        //├────────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────┼──────────────┼──────────────┼───────────┼────────┤
        //│ Caps       │ 7        │ 8        │ 9        │ 0        │   │ Mute       │ Vol Down     │ Vol Up       │           │        │
            &caps_word   &kp N7     &kp N8     &kp N9     &kp N0         &kp C_MUTE   &kp C_VOL_DN   &kp C_VOL_UP   &trans      &trans
        //╰────────────┴──────────┴──────────┼──────────┼──────────┤   ├────────────┼──────────────┼──────────────┴───────────┴────────╯
        //                                   │          │ Escape   │   │            │              │
                                               &trans     &kp ESC        &trans       &trans
        //                                   ╰──────────┴──────────╯   ╰────────────┴──────────────╯
            >;
        };
        
        left_layer {
            display-name = "Left Layer";
            bindings = <
        //╭───────────┬──────────┬──────────┬───────────┬───────────╮   ╭───────────┬───────────┬──────────┬───────────┬───────────╮
        //│ `         │ [        │ {        │ (         │ !         │   │ ^         │ )         │ }        │ ]         │ ~         │
            &kp GRAVE   &kp LBKT   &kp LBRC   &kp LPAR    &kp EXCL        &kp CARET   &kp RPAR    &kp RBRC   &kp RBKT    &kp TILDE
        //├───────────┼──────────┼──────────┼───────────┼───────────┤   ├───────────┼───────────┼──────────┼───────────┼───────────┤
        //│           │ !        │ &        │ =         │ %         │   │ *         │ -         │ |        │ ?         │           │
            &trans      &kp EXCL   &kp AMPS   &kp EQUAL   &kp PRCNT       &kp ASTRK   &kp MINUS   &kp PIPE   &kp QMARK   &trans
        //├───────────┼──────────┼──────────┼───────────┼───────────┤   ├───────────┼───────────┼──────────┼───────────┼───────────┤
        //│           │          │ @        │ +         │ $         │   │ #         │ _         │ \        │ /         │           │
            &trans      &trans     &kp AT     &kp PLUS    &kp DLLR        &kp HASH    &kp UNDER   &kp BSLH   &kp FSLH    &trans
        //╰───────────┴──────────┴──────────┼───────────┼───────────┤   ├───────────┼───────────┼──────────┴───────────┴───────────╯
                                              &trans      &trans          &trans      &trans
        //                                  ╰───────────┴───────────╯   ╰───────────┴───────────╯
            >;
        };

        tri_layer {
            display-name = "Tri Layer";
            bindings = <
        //╭──────────────┬──────────────┬──────────────┬──────────────┬────────────╮   ╭──────────┬──────────┬──────────┬──────────┬─────────────────╮
        //│              │ Profile 0    │ Profile 1    │ Profile 2    │ BT Clear   │   │ F1       │ F2       │ F3       │ F10      │ "Print Screen"  │
            &trans         &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_CLR       &kp F1     &kp F2     &kp F3     &kp F10    &kp LG(LS(S))
        //├──────────────┼──────────────┼──────────────┼──────────────┼────────────┤   ├──────────┼──────────┼──────────┼──────────┼─────────────────┤
        //│              │              │              │              │            │   │ F4       │ F5       │ F6       │ F11      │ Ctrl+Alt+Del    │
            &trans         &trans         &trans         &trans         &trans           &kp F4      &kp F5     &kp F6     &kp F11    &kp LC(LA(DEL))
        //├──────────────┼──────────────┼──────────────┼──────────────┼────────────┤   ├──────────┼──────────┼──────────┼──────────┼─────────────────┤
        //│ Sticky Shift │ Sticky Ctrl  │ Sticky Alt   │ Sticky Super │            │   │ F7       │ F8       │ F9       │ F12      │ To layer 4      │
            &sk LSHFT      &sk LCTRL      &sk LALT       &sk LGUI       &trans           &kp F7     &kp F8     &kp F9     &kp F12    &to 4
        //╰──────────────┴──────────────┴──────────────┼──────────────┼────────────┤   ├──────────┴──────────┼──────────┼──────────┴─────────────────╯
                                                         &trans         &trans           &trans     &trans
        //                                             ╰──────────────┴────────────╯   ╰──────────┴──────────╯
            >;
        };
        
        game_layer {
            display-name = "Game Layer";
            bindings = <
        //╭─────────────┬────────┬────────┬───────────────┬───────────╮   ╭──────────┬──────────┬──────────┬──────────┬────────────╮
        //│             │        │        │               │           │   │ /home    │          │          │          │            │
            &trans        &trans   &trans   &trans          &trans          &mc_home   &trans     &trans     &trans     &trans
        //├─────────────┼────────┼────────┼───────────────┼───────────┤   ├──────────┼──────────┼──────────┼──────────┼────────────┤
        //│ A           │ S      │ D      │ F             │           │   │          │          │          │          │            │
            &kp A         &kp S    &kp D    &kp F           &trans          &trans     &trans     &trans     &trans     &trans
        //├─────────────┼────────┼────────┼───────────────┼───────────┤   ├──────────┼──────────┼──────────┼──────────┼────────────┤
        //│ Z (Shift)   │        │        │               │ Escape    │   │          │          │          │          │ To layer 0 │
            &ht LSHFT Z   &trans   &trans   &trans          &kp ESC         &trans     &trans     &trans     &trans     &to 0
        //╰─────────────┴────────┴────────┼───────────────┼───────────┤   ├──────────┴──────────┼──────────┼──────────┴────────────╯
        //                                │ Tab (Ctrl)    │ Space     │   │          │          │
                                            &ht LCTRL TAB   &kp SPACE       &trans     &trans
        //                                ╰───────────────┴───────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
